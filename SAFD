# ====== CONFIG ======
SPEED_MAX = 40.5       # km/h
ACC_MIN, ACC_MAX = -2.5, 2.5  # m/s²
NBINS_S, NBINS_A = 20, 20     # number of bins
SHOW_PERCENT = True           # True = percent; False = raw counts
COLS = {
    "HHD": ("SPEED_HHD", "ACCELERATION_HHD"),
    "MHD": ("SPEED_MHD", "ACCELERATION_MHD"),
    "LHD": ("SPEED_LHD", "ACCELERATION_LHD"),
}
COLORS = {"HHD":"#1f77b4", "MHD":"#ff7f0e", "LHD":"#2ca02c"}  # paper-friendly

# Common bin edges for all classes (important for comparability)
xbins = np.linspace(0, SPEED_MAX, NBINS_S + 1)
ybins = np.linspace(ACC_MIN, ACC_MAX, NBINS_A + 1)

def safd_hist(speed, accel, xbins, ybins, to_percent=True):
    # clip and compute 2D histogram
    s = np.clip(np.asarray(speed, float), 0, SPEED_MAX)
    a = np.clip(np.asarray(accel, float), ACC_MIN, ACC_MAX)
    H, xe, ye = np.histogram2d(s, a, bins=[xbins, ybins])
    if to_percent and H.sum() > 0:
        H = (H / H.sum()) * 100.0
    return H.T, xe, ye  # transpose so rows=accel bins, cols=speed bins

def bar3d_from_hist(ax, H, xedges, yedges, color="teal", alpha=0.8, zmax=None):
    # bar centers and sizes
    xw = np.diff(xedges)   # width per speed bin
    yw = np.diff(yedges)   # depth per accel bin
    xc = xedges[:-1] + xw/2
    yc = yedges[:-1] + yw/2
    Xc, Yc = np.meshgrid(xc, yc, indexing="xy")

    xpos = Xc.ravel()
    ypos = Yc.ravel()
    zpos = np.zeros_like(xpos)

    dx = np.repeat(xw, len(yw)) * 0.9  # small gap
    dy = np.tile(yw,  len(xw)) * 0.9
    dz = H.ravel()

    ax.bar3d(xpos, ypos, zpos, dx, dy, dz, shade=True, color=color, alpha=alpha)
    ax.set_xlim(xedges[0], xedges[-1])
    ax.set_ylim(yedges[0], yedges[-1])
    if zmax is not None:
        ax.set_zlim(0, zmax)

def build_class_hist(df, cls_key):
    s_col, a_col = COLS[cls_key]
    return safd_hist(df[s_col], df[a_col], xbins, ybins, to_percent=SHOW_PERCENT)

# ---- Build histograms for all classes ----
H_grids = {cls: build_class_hist(df, cls)[0] for cls in COLS.keys()}
xedges = xbins
yedges = ybins

# same Z scale across subplots
ZMAX = max(np.nanmax(H) for H in H_grids.values() if H.size)

# ---- Plot 3 subplots side-by-side ----
fig = plt.figure(figsize=(10, 5.4))  # compact, paper-ready
for i, cls in enumerate(["HHD", "MHD", "LHD"], start=1):
    ax = fig.add_subplot(1, 3, i, projection="3d")
    bar3d_from_hist(ax, H_grids[cls], xedges, yedges, color=COLORS[cls], alpha=0.85, zmax=ZMAX)
    ax.set_title(f"3D SAFD – {cls}", fontweight="bold", pad=10)
    ax.set_xlabel("Speed (km/h)", fontweight="bold")
    ax.set_ylabel("Acceleration (m/s²)", fontweight="bold")
    ax.set_zlabel("Share (%)" if SHOW_PERCENT else "Count", fontweight="bold")
    # nicer viewing angle
    ax.view_init(elev=25, azim=-60)

plt.tight_layout()
