# ================== CONFIG ==================
FS = 1.0                 # Hz (samples per second)
TARGET_CYCLE_SEC = 1200  # 20 min per cycle
STOP_KMH = 3.5           # stop threshold
MIN_STOP_SEC = 2         # min consecutive stop seconds to define microtrip boundaries
IDLE_GAP_SEC = 3         # seconds of idle inserted between microtrips
SPEED_CAP = 40.5         # km/h (your stated max)
SMOOTH_WIN = 5           # Savitzky-Golay window (odd); set 0 to disable
SMOOTH_POLY = 2
COLS = {"HHD": "SPEED_HHD", "MHD": "SPEED_MHD", "LHD": "SPEED_LHD"}
