import pandas as pd


# 1) Your OpMode classifier (speed in mph directly)
def classify_opmode(stp, v_mph):
    # Idle
    if v_mph < 1.0:
        return 1

    # Coast
    if 1.0 <= v_mph < 15 and stp < 0:  return 11
    if 15.0 <= v_mph < 50 and stp < 0: return 21
    if v_mph >= 50 and stp < 6:        return 33

    # Cruise/Acceleration
    if 1.0 <= v_mph < 15:
        if 0 <= stp < 3:   return 12
        if 3 <= stp < 6:   return 13
        if 6 <= stp < 9:   return 14
        if 9 <= stp < 12:  return 15
        if stp >= 12:      return 16

    if 15.0 <= v_mph < 50:
        if 0 <= stp < 3:   return 22
        if 3 <= stp < 6:   return 23
        if 6 <= stp < 9:   return 24
        if 9 <= stp < 12:  return 25
        if 12 <= stp < 18: return 27
        if 18 <= stp < 24: return 28
        if 24 <= stp < 30: return 29
        if stp >= 30:      return 30

    if v_mph >= 50:
        if 6  <= stp < 12: return 35
        if 12 <= stp < 18: return 37
        if 18 <= stp < 24: return 38
        if 24 <= stp < 30: return 39
        if stp >= 30:      return 40

    # Decel/Braking fallback
    return 0

# 2) Apply to every row
df["OpMode_calc"] = [classify_opmode(stp, v) for stp, v in zip(df["STP"], df["SPEED"])]

# 3) Check mismatch with existing OPMODE (if present)
