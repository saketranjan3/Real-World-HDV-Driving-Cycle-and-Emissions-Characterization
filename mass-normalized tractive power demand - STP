def to_mph(x, unit):
    if unit == "mph": return x
    if unit == "kph": return x * 0.621371
    if unit == "mps": return x * 2.23694
    raise ValueError("SPEED_UNIT must be one of: 'mps','kph','mph'")

# convert each Speed_* to mph (MOVES table uses mph)
for tag in ["H","M","L"]:
    df[f"Speed_{tag}_mph"] = to_mph(df[f"Speed_{tag}"], SPEED_UNIT)

def classify_opmode(stp, v_mph):
    # 1) Idle
    if v_mph < 1.0:
        return 1

    # 2) Coast (v in [1,25) or [25,50), or v >= 50 special)
    if 1.0 <= v_mph < 25 and stp < 0:  return 11
    if 25.0 <= v_mph < 50 and stp < 0: return 21
    if v_mph >= 50 and stp < 6:        return 33

    # 3) Cruise/Accel by speed band
    if 1.0 <= v_mph < 25:
        if 0 <= stp < 3:   return 12
        if 3 <= stp < 6:   return 13
        if 6 <= stp < 9:   return 14
        if 9 <= stp < 12:  return 15
        if stp >= 12:      return 16

    if 25.0 <= v_mph < 50:
        if 0 <= stp < 3:   return 22
        if 3 <= stp < 6:   return 23
        if 6 <= stp < 9:   return 24
        if 9 <= stp < 12:  return 25
        if 12 <= stp < 18: return 27
        if 18 <= stp < 24: return 28
        if 24 <= stp < 30: return 29
        if stp >= 30:      return 30

    if v_mph >= 50:
        if 6  <= stp < 12: return 35
        if 12 <= stp < 18: return 37
        if 18 <= stp < 24: return 38
        if 24 <= stp < 30: return 39
        if stp >= 30:      return 40

    # 0 = Decel/Braking (fallback)
    return 0

# compute OpMode for each class
for tag in ["H","M","L"]:
